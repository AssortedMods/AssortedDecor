{
  "schemaVersion": 1,
  "id": "${mod_id}_gametest",
  "version": "${version}",
  "name": "${mod_name} Game Tests",
  "description": "Development-only gametests for ${mod_name}. Never built into a release artifact.",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.grim3212.assorted.lights.gametest.LightsFabricGameTests"
    ],
    "fabric-client-gametest": [
      "com.grim3212.assorted.lights.gametest.LightsClientGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "${mod_id}": "*"
  }
}
